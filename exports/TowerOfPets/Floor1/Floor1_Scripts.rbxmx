-- decorative / effect pieces players should walk through
M.NoCollide = {"Particles", "Energy", "EnergyRing", "Sparkle", "Cloud", "Leaf", "Leaves", "Vine", "Banner",
	"Waterfall", "Mist", "Glow", "Grass_Tuft", "Ground_Plant", "Flower", "Rivers", "Lakes"}

-- walkable terrain: exact collision (needs Studio / command bar permission, ignored in game scripts)
M.PreciseCollision = {"_Top__", "_Cliffs__", "Natural_Bridges", "_Deck__", "Entrance_Walk"}

function M.apply(root)
	for _, part in ipairs(root:GetDescendants()) do
		if part:IsA("MeshPart") then
			local key = part.Name:match("__(.+)$")
			key = key and key:gsub("%.%d+$", "")
			local spec = key and M.Materials[key]
			if key and not spec then  -- chunked parts end in _1, _2 ...
				spec = M.Materials[key:match("^(.-)_%d+$") or ""]
			end
			if spec then
				part.Color = spec.Color
				part.Material = spec.Material
				part.Transparency = spec.Transparency
				part.TextureID = ""
			end
			part.Anchored = true
			for _, pat in ipairs(M.PreciseCollision) do
				if part.Name:find(pat) then
					pcall(function() part.CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition end)
					break
				end
			end
			if part.Name:find("TeleportTrigger") then  -- invisible touch volumes
				part.Transparency, part.CanCollide, part.CastShadow = 1, false, false
			else
				for _, pat in ipairs(M.NoCollide) do
					if part.Name:find(pat) then part.CanCollide = false; part.CanQuery = false; break end
				end
			end
		end
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Floor1_Scatter</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets Floor 1: places the environment detail (trees, foliage, rocks, props, ruins, water and
-- cliff dressing, landmark pieces, background) from the Floor1_Scatter_* data modules.
-- Generated by blender/tower_of_pets/build_floor1_pack.py. See exports/TowerOfPets/Floor1/IMPORT.md.
--
-- Setup: import Floor1_Assets.fbx and put the imported model in ServerStorage named "Floor1_Assets";
-- put every Floor1_Scatter_* ModuleScript in a Folder ServerStorage.Floor1_ScatterData; then run in the
-- command bar:  require(game.ServerStorage.Floor1_Scatter).place()
-- Options: place({texture = "rbxassetid://<palette id>", lights = true, categories = {"Trees", ...}})
-- Categories: Trees, Foliage, Rocks, Props, Ruins, Water, Cliffs, Landmarks, Background
local M = {}

-- collision / shadows / streaming per category
M.Rules = {
	Trees = {collide = false, trunk = true, shadow = true},
	Foliage = {collide = false, shadow = false},
	Rocks = {collide = true, fidelity = "Hull", shadow = true, smallNoCollide = 4},
	Props = {collide = true, fidelity = "Box", shadow = true},
	Ruins = {collide = true, fidelity = "Hull", shadow = true},
	Water = {collide = false, shadow = false},
	Cliffs = {collide = false, shadow = false},
	Landmarks = {collide = false, shadow = true, persistent = true},
	Background = {collide = false, shadow = false, persistent = true},
}

-- asset -> offset (studs, Roblox axes) from the asset's ground origin to its mesh centre, at scale 1
M.Offsets = {
	Barrel = Vector3.new(0.000, 1.200, -0.000),
	Bench = Vector3.new(0.000, 1.175, -0.050),
	Bridge_Long = Vector3.new(0.000, -0.029, -35.000),
	Broken_Column_A = Vector3.new(1.055, 4.082, -0.228),
	Broken_Column_B = Vector3.new(1.055, 6.649, -0.228),
	Broken_Wall = Vector3.new(0.558, 2.862, -1.360),
	Bush_01 = Vector3.new(-0.111, 1.127, -0.038),
	Bush_01_Mystic = Vector3.new(-0.111, 1.127, -0.038),
	Bush_02 = Vector3.new(-0.008, 1.342, -0.127),
	Bush_03 = Vector3.new(0.254, 1.711, -0.009),
	Bush_03_Mystic = Vector3.new(0.254, 1.711, -0.009),
	Castle_Lantern = Vector3.new(0.000, 5.500, -0.000),
	Cloud_A = Vector3.new(0.052, 0.316, 0.091),
	Cloud_B = Vector3.new(0.375, 0.307, -0.027),
	Cloud_C = Vector3.new(0.006, 0.322, 0.141),
	Cloud_D = Vector3.new(-0.041, 0.299, -0.017),
	Crate = Vector3.new(0.000, 1.000, -0.000),
	Crystal_Island = Vector3.new(1.141, -29.295, -0.721),
	Fern = Vector3.new(0.011, 0.953, 0.015),
	Flower_Cluster_Pink = Vector3.new(0.006, 0.758, 0.011),
	Flower_Cluster_Purple = Vector3.new(0.002, 0.756, 0.001),
	Flower_Cluster_White = Vector3.new(-0.011, 0.812, 0.006),
	Flower_Cluster_Yellow = Vector3.new(0.002, 0.756, 0.001),
	Foam_Ring = Vector3.new(0.152, 0.150, -0.000),
	Grass_Patch = Vector3.new(-0.128, 0.884, -0.174),
	Grass_Tuft = Vector3.new(0.322, 0.778, -0.255),
	Ground_Plant_01 = Vector3.new(-0.051, 0.988, 0.026),
	Ground_Plant_02 = Vector3.new(0.028, 0.512, 0.036),
	Lantern_Post = Vector3.new(0.000, 5.925, -0.000),
	Lantern_Wood = Vector3.new(0.000, 4.800, -0.000),
	Large_Island = Vector3.new(-0.518, -55.170, 0.174),
	Leaf_Cluster_A = Vector3.new(0.089, -0.162, -0.005),
	Leaf_Cluster_B = Vector3.new(-0.010, 0.005, 0.062),
	Leaf_Cluster_C = Vector3.new(0.123, -0.132, -0.099),
	Leaf_Cluster_Low = Vector3.new(-0.971, -0.294, 0.141),
	Lily_Pads = Vector3.new(-0.332, 0.050, 0.041),
	Lily_Pads_Flower = Vector3.new(0.355, 0.265, -0.873),
	Log = Vector3.new(0.000, 1.543, -0.509),
	Medium_Island = Vector3.new(0.844, -36.195, -0.631),
	Mist_Puff = Vector3.new(-0.243, 0.802, -1.712),
	Moss_Drape_A = Vector3.new(0.000, -1.775, -0.250),
	Moss_Drape_B = Vector3.new(0.000, -3.204, -0.250),
	Mushrooms = Vector3.new(-0.148, 0.853, -0.125),
	Mushrooms_Glow = Vector3.new(-0.059, 0.892, 0.107),
	Reeds = Vector3.new(0.104, 2.652, 0.541),
	Rock_A = Vector3.new(-0.018, -0.117, -0.103),
	Rock_B = Vector3.new(-0.058, 0.043, -0.002),
	Rock_C = Vector3.new(0.060, 0.155, -0.035),
	Rock_Formation = Vector3.new(-0.167, -8.938, -1.197),
	Rock_Large = Vector3.new(0.043, -3.600, -0.626),
	Rock_Medium = Vector3.new(-0.129, -2.000, 0.168),
	Rock_Small = Vector3.new(0.195, -0.960, -0.085),
	Root_Single = Vector3.new(1.697, 0.785, 0.062),
	Rope_Barrier = Vector3.new(0.000, 1.600, -0.000),
	Ruin_Arch = Vector3.new(0.000, 7.350, -0.000),
	Signpost = Vector3.new(1.321, 3.200, -0.683),
	Small_Island = Vector3.new(0.249, -19.635, 0.177),
	Stone_Fragments = Vector3.new(1.252, 0.400, -0.167),
	Stone_Planter = Vector3.new(0.000, 1.691, -0.000),
	Stump = Vector3.new(-0.012, 0.566, 0.029),
	Tall_Island = Vector3.new(-0.043, -31.650, 0.523),
	Temple_Platform = Vector3.new(0.000, -0.655, -0.000),
	Tree_Large_High = Vector3.new(1.337, 10.939, 1.689),
	Tree_Large_Low = Vector3.new(1.853, 11.198, 1.823),
	Tree_Large_Mystic = Vector3.new(1.853, 11.198, 1.823),
	Tree_Medium_High = Vector3.new(-0.239, 9.432, -0.733),
	Tree_Medium_Low = Vector3.new(-0.092, 9.398, -1.203),
	Tree_Medium_Mystic = Vector3.new(-0.092, 9.398, -1.203),
	Tree_Small_Low = Vector3.new(-0.033, 6.211, 0.582),
	Tree_Tall_Thin_Low = Vector3.new(-0.519, 10.788, -0.848),
	Tree_Tall_Thin_Mystic = Vector3.new(-0.519, 10.788, -0.848),
	Verdant_Banner_Pole = Vector3.new(0.000, 9.700, -0.000),
	Vine_Long = Vector3.new(-0.088, -3.674, 0.036),
	Waterfall_Large = Vector3.new(-0.775, -61.346, 0.919),
	Waterfall_Medium = Vector3.new(-0.222, -30.627, -0.460),
	Wood_Fence = Vector3.new(0.000, 1.500, -0.000),
}

-- tree trunks get a simple invisible cylinder collider: radius, height (scale 1)
M.Trunks = {
	Tree_Large_Low = {2.3, 9},
	Tree_Medium_Low = {1.4, 8},
	Tree_Small_Low = {1.2, 6},
	Tree_Tall_Thin_Low = {1.0, 10},
	Tree_Large_Mystic = {2.3, 9},
	Tree_Medium_Mystic = {1.4, 8},
	Tree_Small_Mystic = {1.2, 6},
	Tree_Tall_Thin_Mystic = {1.0, 10},
	Tree_Large_High = {2.3, 9},
	Tree_Medium_High = {1.4, 8},
	Tree_Small = {1.2, 6},
}

M.Transparency = {Mist_Puff = 0.45}
M.Lights = {Lantern_Wood = {7.4, 22, 1.4}, Castle_Lantern = {7.6, 24, 1.5}, Lantern_Post = {9.5, 26, 1.5}}

local function findAsset(assets, name)
	local a = assets:FindFirstChild(name, true)
	if a and a:IsA("Model") then a = a:FindFirstChildWhichIsA("MeshPart", true) end
	return a
end

function M.place(opts)
	opts = opts or {}
	local assets = opts.assets or game.ServerStorage:FindFirstChild("Floor1_Assets")
	local data = opts.data or game.ServerStorage:FindFirstChild("Floor1_ScatterData")
	assert(assets, "put the imported Floor1_Assets model in ServerStorage")
	assert(data, "put the Floor1_Scatter_* modules in ServerStorage.Floor1_ScatterData")
	local only = nil
	if opts.categories then only = {}; for _, c in ipairs(opts.categories) do only[c] = true end end
	-- no categories: rebuild everything; with categories: replace only those (run one category at a time
	-- if a single big call is too slow)
	local root = (opts.parent or workspace):FindFirstChild("Floor1_Environment")
	if root and not only then root:Destroy(); root = nil end
	if not root then
		root = Instance.new("Folder"); root.Name = "Floor1_Environment"; root.Parent = opts.parent or workspace
	end
	if only then for c in pairs(only) do local old = root:FindFirstChild(c); if old then old:Destroy() end end end
	local groups, count, missing = {}, 0, {}
	for _, mod in ipairs(data:GetChildren()) do
		if not mod:IsA("ModuleScript") then continue end
		local d = require(mod)
		if only and not only[d.category] then continue end
		local rule = M.Rules[d.category] or {}
		local g = groups[d.category]
		if not g then
			g = Instance.new("Model"); g.Name = d.category
			if rule.persistent then g.ModelStreamingMode = Enum.ModelStreamingMode.Persistent end
			g.Parent = root; groups[d.category] = g
		end
		for name, arr in pairs(d.items) do
			local src = findAsset(assets, name)
			if not src then missing[name] = true; continue end
			local off = M.Offsets[name] or Vector3.zero
			local trunk, light = M.Trunks[name], M.Lights[name]
			for i = 1, #arr, 5 do
				local s = arr[i + 4]
				local base = CFrame.new(arr[i], arr[i + 1], arr[i + 2]) * CFrame.Angles(0, math.rad(arr[i + 3]), 0)
				local p = src:Clone()
				p.Name = name
				p.Size = src.Size * s
				p.CFrame = base * CFrame.new(off * s)
				p.Anchored = true
				if opts.texture then p.TextureID = opts.texture end
				p.Transparency = M.Transparency[name] or 0
				local small = rule.smallNoCollide and p.Size.Magnitude < rule.smallNoCollide * 3
				p.CanCollide = rule.collide == true and not small
				p.CanQuery, p.CanTouch = p.CanCollide, false
				p.CastShadow = rule.shadow == true
				if p.CanCollide and rule.fidelity then
					pcall(function() p.CollisionFidelity = Enum.CollisionFidelity[rule.fidelity] end)
				else
					pcall(function() p.CollisionFidelity = Enum.CollisionFidelity.Box end)
				end
				p.Parent = g
				if rule.trunk and trunk then  -- riders bump into trunks, ride under canopies
					local c = Instance.new("Part")
					c.Name = name .. "_Trunk"
					c.Shape = Enum.PartType.Cylinder
					c.Size = Vector3.new(trunk[2] * s, trunk[1] * 2 * s, trunk[1] * 2 * s)
					c.CFrame = base * CFrame.new(0, trunk[2] * s / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
					c.Anchored, c.Transparency, c.CastShadow, c.CanTouch = true, 1, false, false
					c.Parent = p
				end
				if opts.lights and light then
					local a = Instance.new("Attachment"); a.Position = p.CFrame:PointToObjectSpace(
						(base * CFrame.new(0, light[1] * s, 0)).Position); a.Parent = p
					local l = Instance.new("PointLight"); l.Range = light[2]; l.Brightness = light[3]
					l.Color = Color3.fromRGB(255, 196, 120); l.Shadows = false; l.Parent = a
				end
				count += 1
			end
		end
	end
	for name in pairs(missing) do warn("Floor1_Scatter: asset not found: " .. name) end
	print(("Floor1_Scatter: placed %d pieces"):format(count))
	return root
end

-- palette texture for every asset (if the importer did not bring it in): upload Floor1_Palette.png, then
-- require(game.ServerStorage.Floor1_Scatter).setTexture("rbxassetid://<id>")
function M.setTexture(id, where)
	for _, p in ipairs((where or workspace:FindFirstChild("Floor1_Environment")):GetDescendants()) do
		if p:IsA("MeshPart") then p.TextureID = id end
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Floor1_Lighting</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets Floor 1: bright fantasy daylight (generated by build_floor1_pack.py).
-- Run once in the command bar:  require(game.ServerStorage.Floor1_Lighting).apply()
local M = {}

local function child(parent, class, name)
	local c = parent:FindFirstChild(name)
	if c and not c:IsA(class) then c:Destroy(); c = nil end
	if not c then c = Instance.new(class); c.Name = name; c.Parent = parent end
	return c
end

function M.apply()
	local L = game:GetService("Lighting")
	-- a world this size: ShadowMap keeps soft sun shadows and costs far less than Future
	L.Technology = Enum.Technology.ShadowMap
	L.ClockTime = 13.6
	L.GeographicLatitude = 35
	L.Brightness = 2.6
	L.ExposureCompensation = 0.1
	L.Ambient = Color3.fromRGB(110, 118, 138)
	L.OutdoorAmbient = Color3.fromRGB(150, 160, 178)
	L.ColorShift_Top = Color3.fromRGB(255, 236, 205)
	L.EnvironmentDiffuseScale = 0.5
	L.EnvironmentSpecularScale = 0.3
	L.ShadowSoftness = 0.3
	L.GlobalShadows = true
	local a = child(L, "Atmosphere", "Floor1_Atmosphere")       -- soft blue haze for depth
	a.Density, a.Offset, a.Glare, a.Haze = 0.28, 0.2, 0.15, 1.4
	a.Color, a.Decay = Color3.fromRGB(199, 226, 255), Color3.fromRGB(110, 156, 212)
	local b = child(L, "BloomEffect", "Floor1_Bloom")             -- subtle glow on lanterns, water, crystals
	b.Intensity, b.Size, b.Threshold = 0.45, 28, 1.4
	local c = child(L, "ColorCorrectionEffect", "Floor1_Color")  -- vibrant, readable colours
	c.Brightness, c.Contrast, c.Saturation = 0.02, 0.06, 0.15
	c.TintColor = Color3.fromRGB(255, 250, 242)
	local r = child(L, "SunRaysEffect", "Floor1_SunRays")
	r.Intensity, r.Spread = 0.05, 0.6
	local s = child(L, "Sky", "Floor1_Sky")
	s.SunAngularSize, s.MoonAngularSize, s.CelestialBodiesShown = 14, 9, true
	local cl = child(workspace.Terrain, "Clouds", "Floor1_Clouds")
	cl.Cover, cl.Density, cl.Color = 0.55, 0.65, Color3.fromRGB(255, 255, 255)
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Floor1_Lights</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets: lamps from the Blender lobby as PointLight specs (generated by export_fbx.py).
-- Positions are world studs, valid when the FBX files were imported with "Insert Using Scene Position".
local M = {}

M.Lights = {
	{Name = "Hatchery_Light_0", Position = Vector3.new(-5279.331, 74.75, 3759.449), Color = Color3.fromRGB(231, 179, 255), Brightness = 2.93, Range = 50.9},
	{Name = "Hatchery_Light_1", Position = Vector3.new(-5276.758, 65.75, 3763.736), Color = Color3.fromRGB(255, 179, 249), Brightness = 1.6, Range = 31.2},
	{Name = "Hatchery_Light_2", Position = Vector3.new(-5288.249, 69.75, 3760.135), Color = Color3.fromRGB(149, 231, 255), Brightness = 1.4, Range = 27.0},
	{Name = "Hatchery_Light_3", Position = Vector3.new(-5274.529, 69.75, 3751.903), Color = Color3.fromRGB(149, 231, 255), Brightness = 1.4, Range = 27.0},
	{Name = "Hatchery_Light_4", Position = Vector3.new(-5269.812, 74.75, 3775.312), Color = Color3.fromRGB(255, 218, 170), Brightness = 2.8, Range = 49.3},
	{Name = "Hatchery_Light_5", Position = Vector3.new(-5280.017, 86.75, 3785.517), Color = Color3.fromRGB(255, 218, 170), Brightness = 1.8, Range = 34.9},
	{Name = "Hatchery_Light_6", Position = Vector3.new(-5256.007, 86.75, 3771.111), Color = Color3.fromRGB(255, 218, 170), Brightness = 1.8, Range = 34.9},
	{Name = "Shop_Light_0", Position = Vector3.new(-5172.728, 73.75, 3937.121), Color = Color3.fromRGB(255, 218, 166), Brightness = 3.0, Range = 60},
	{Name = "Shop_Light_1", Position = Vector3.new(-5162.609, 68.75, 3940.38), Color = Color3.fromRGB(255, 218, 166), Brightness = 3.0, Range = 53.2},
	{Name = "Shop_Light_2", Position = Vector3.new(-5174.614, 68.75, 3947.583), Color = Color3.fromRGB(255, 218, 166), Brightness = 3.0, Range = 53.2},
	{Name = "Shop_Light_3", Position = Vector3.new(-5178.901, 69.75, 3926.831), Color = Color3.fromRGB(255, 218, 166), Brightness = 2.8, Range = 49.3},
	{Name = "Shop_Light_4", Position = Vector3.new(-5168.011, 73.75, 3913.883), Color = Color3.fromRGB(255, 218, 166), Brightness = 2.0, Range = 38.2},
	{Name = "Shop_Light_5", Position = Vector3.new(-5195.451, 73.75, 3930.347), Color = Color3.fromRGB(255, 218, 166), Brightness = 2.0, Range = 38.2},
}

-- creates an invisible anchored holder part per light inside `parent` (e.g. a "Lights" Folder)
function M.build(parent)
	for _, d in ipairs(M.Lights) do
		local p = Instance.new("Part")
		p.Name = d.Name
		p.Size = Vector3.new(0.5, 0.5, 0.5)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Transparency = 1
		p.Position = d.Position
		local l = Instance.new("PointLight")
		l.Color, l.Brightness, l.Range, l.Shadows = d.Color, d.Brightness, d.Range, false
		l.Parent = p
		p.Parent = parent
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX16"><Properties><string name="Name">Floor1_ScatterData</string></Properties><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Floor1_Scatter_Background_1</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets Floor 1 scatter: Background (371 placements).
-- Generated by blender/tower_of_pets/build_floor1_pack.py - x, y, z (studs), yaw (deg), scale.
return {
	category = "Background",
	items = {
		Cloud_A = {7493,848.8,-4450,84,65.89,10957,3730.8,27,329,236.10,7986,1983.9,-7790,316,275.15,-4299,1188.8,10918,211,302.95,-8600,3253.3,-5890,148,200.27,6747,435.7,10839,84,243.07,3725,-3170.1,816,1,312.38,2061,-3190.6,1889,131,266.48,6296,-3022.4,2264,295,263.90},
		Cloud_B = {6514,756.8,-5115,238,50.60,5513,931.5,-5358,148,71.71,11233,2074.2,1161,188,218.59,-5597,3654.5,-10399,162,281.19,10574,176.3,4543,22,212.77,-10820,-77.1,-8481,219,267.96,10771,1225.8,-1807,332,225.52,-7538,90.2,-8432,210,247.29,5870,3211.4,9154,325,320.92,-2991,2226.9,-8749,172,274.65,18549,-131.6,575,266,314.39,15575,2271.7,-6457,272,292.82,5767,4150.9,8895,135,305.54,-14357,-181.9,7184,108,233.52,-5560,2839.5,10256,166,226.50,5509,-2405.5,-1738,321,337.79,-2668,-2929.9,-3636,232,263.84},
		Cloud_C = {5478,916.3,-5113,100,47.09,7669,854.2,-4225,23,44.63,-8549,2094.8,9282,208,267.25,-9635,3183.8,-2807,30,252.82,-7184,1838.6,7649,347,292.12,16091,3180.3,3866,21,295.27,-10962,269.6,-5777,59,251.29,-11163,2485.2,934,27,201.57,-11471,2252.0,-3968,114,234.57,17520,3530.9,-2727,1,287.00,17258,224.1,-3885,222,322.57,12509,1275.3,-1529,7,272.53,3063,-2771.3,4006,171,329.88},
		Cloud_D = {6271,1252.4,-3061,341,71.25,6783,1333.9,-3383,185,76.97,5175,1101.8,-5285,12,68.75,6573,790.3,-5120,347,63.55,6814,828.5,-4994,221,70.94,3677,2823.5,9151,322,233.91,18592,2898.4,-853,25,334.70,-2828,3945.7,8442,173,338.08,-6450,1346.3,10469,321,329.51,5047,-2759.3,-2544,221,243.36,4213,-3094.1,-3690,351,254.14},
		Crystal_Island = {-2579,3249.8,-8017,21,14.68,2622,1211.6,8127,318,8.31,-6837,1513.7,-6676,46,9.83,-4068,1964.9,7766,265,14.58,10505,1591.8,-7368,25,10.22,7460,1600.2,-8834,258,15.41,-8563,3106.9,8105,248,15.18,8102,2128.6,8743,173,16.77},
