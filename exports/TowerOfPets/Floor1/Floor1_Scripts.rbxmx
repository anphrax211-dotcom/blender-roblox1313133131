	{Name = "Village_Light_House_Smith", Position = Vector3.new(-5009.821, 71.478, 3821.155), Color = Color3.fromRGB(255, 215, 158), Brightness = 2.27, Range = 42.2},
	{Name = "Village_Light_House_Weaver", Position = Vector3.new(-4951.998, 70.587, 3808.884), Color = Color3.fromRGB(255, 215, 158), Brightness = 2.27, Range = 42.2},
}

-- creates an invisible anchored holder part per light inside `parent` (e.g. a "Lights" Folder)
function M.build(parent)
	for _, d in ipairs(M.Lights) do
		local p = Instance.new("Part")
		p.Name = d.Name
		p.Size = Vector3.new(0.5, 0.5, 0.5)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Transparency = 1
		p.Position = d.Position
		local l = Instance.new("PointLight")
		l.Color, l.Brightness, l.Range, l.Shadows = d.Color, d.Brightness, d.Range, false
		l.Parent = p
		p.Parent = parent
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Floor1_Village</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets Floor 1: Verdant Village placeholder houses and market stalls (generated by
-- blender/tower_of_pets/floor1_roblox.py). NpcSpot = where a quest NPC stands (feet), Facing = look direction.
local M = {}

M.Houses = {
	{Name = "House_Elder", Role = "Elder", Position = Vector3.new(-5224.7, 66.8, 3994.4), NpcSpot = Vector3.new(-5230.5, 69.9, 3977.3), Facing = Vector3.new(-0.002, 0.0, -1.0)},
	{Name = "House_Baker", Role = "Baker", Position = Vector3.new(-5130.0, 61.5, 3872.3), NpcSpot = Vector3.new(-5141.0, 64.6, 3859.5), Facing = Vector3.new(-0.35, 0.0, -0.937)},
	{Name = "House_Smith", Role = "Smith", Position = Vector3.new(-5011.7, 59.8, 3836.3), NpcSpot = Vector3.new(-5020.4, 62.9, 3821.8), Facing = Vector3.new(-0.19, 0.0, -0.982)},
	{Name = "House_Weaver", Role = "Weaver", Position = Vector3.new(-4956.4, 58.9, 3825.3), NpcSpot = Vector3.new(-4962.5, 62.0, 3810.6), Facing = Vector3.new(-0.282, 0.0, -0.959)},
	{Name = "House_Gardener", Role = "Gardener", Position = Vector3.new(-5184.2, 59.7, 3774.2), NpcSpot = Vector3.new(-5173.3, 62.8, 3786.4), Facing = Vector3.new(0.352, 0.0, 0.936)},
	{Name = "House_Scholar", Role = "Scholar", Position = Vector3.new(-5133.4, 60.0, 3757.7), NpcSpot = Vector3.new(-5123.4, 63.1, 3771.4), Facing = Vector3.new(0.274, 0.0, 0.962)},
	{Name = "House_Herbalist", Role = "Herbalist", Position = Vector3.new(-5082.7, 58.8, 3741.3), NpcSpot = Vector3.new(-5078.0, 61.9, 3755.2), Facing = Vector3.new(0.209, 0.0, 0.978)},
	{Name = "House_Fisher", Role = "Fisher", Position = Vector3.new(-5346.1, 59.8, 3733.7), NpcSpot = Vector3.new(-5331.5, 62.9, 3739.6), Facing = Vector3.new(0.721, 0.0, 0.693)},
}

M.Stalls = {
	{Name = "Stall_Fruit", Position = Vector3.new(-5097.1, 58.9, 3845.5), NpcSpot = Vector3.new(-5096.9, 58.9, 3846.5), Facing = Vector3.new(-0.146, 0.0, -0.989)},
	{Name = "Stall_Flowers", Position = Vector3.new(-5062.8, 59.4, 3836.6), NpcSpot = Vector3.new(-5062.6, 59.4, 3837.6), Facing = Vector3.new(-0.199, 0.0, -0.98)},
}

-- creates an anchored, invisible, non-colliding marker Part per NPC spot inside `parent` (e.g. a Folder
-- workspace.Floor1.NPCSpots), facing the road, with Role / House attributes for your quest scripts
function M.buildSpots(parent)
	local all = {}
	for _, h in ipairs(M.Houses) do table.insert(all, {Name = h.Name, Role = h.Role, Spot = h.NpcSpot, Facing = h.Facing}) end
	for _, s in ipairs(M.Stalls) do table.insert(all, {Name = s.Name, Role = "Merchant", Spot = s.NpcSpot, Facing = s.Facing}) end
	for _, d in ipairs(all) do
		local p = Instance.new("Part")
		p.Name = "NPC_" .. d.Name
		p.Size = Vector3.new(2, 5, 2)
		local at = d.Spot + Vector3.new(0, 2.5, 0)
		p.CFrame = CFrame.lookAt(at, at + d.Facing)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Transparency = 1
		p:SetAttribute("Role", d.Role)
		p:SetAttribute("House", d.Name)
		p.Parent = parent
	end
	return #all
end

return M
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX17"><Properties><string name="Name">Floor1_ScatterData</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Floor1_Scatter_Background_1</string><ProtectedString name="Source"><![CDATA[-- Tower of Pets Floor 1 scatter: Background (371 placements).
